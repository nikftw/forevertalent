# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# create-next-app leftovers
/public/next.svg
/public/vercel.svg
/public/globe.svg
/public/file.svg
/public/window.svg

# local scratch / OCR / agent work products (not reference screenshots)
.tmp/
tmp/
.tmp_*
/Claude outputs/

# one-off public dumps (keep class*new/ reference folders tracked)
/public/image.png
/public/classrace.png
/public/new-racial-talents-*.png

# unmapped historical crops still sitting in class folders
/public/*/brave_*.png
/public/*/overview part.png
/public/*/overviewpart*.png
/public/*/overview-clean.png
/public/*/overview-rend.png
/public/*/overview-focus.png
/public/*/fix*.png
/public/*/O2NJQmcycc.jpg

# scrape helpers and generated slot crops
/src/data/scrapes/_*/
/src/data/scrapes/_*.py
/src/data/scrapes/_*.txt
/src/data/scrapes/_*.png
